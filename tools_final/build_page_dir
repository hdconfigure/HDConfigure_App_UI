traverse_pages() {
    if [ ! -d "$1" ]; then
        echo "Error: '$1' is not a valid directory." >&2
        return 1
    fi

    find "$1" -type f -name "index.pagebuilder" -exec sh -c '
        for file do
            build_page "$file" > "index.html
        done
    ' sh {} +
}
traverse_pages "$1";
