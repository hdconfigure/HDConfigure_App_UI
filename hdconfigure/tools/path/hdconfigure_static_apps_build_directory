traverse_pages() {
    if [ ! -d "$1" ]; then
        echo "Error: '$1' is not a valid directory." >&2
        return 1
    fi

    # Example using find properly with sh:
    find "$1" -type f -name "*.html" -exec sh -c '
        for file do
            dir_path="$(dirname "$file")"
            hdconfigure_static_apps_build_page "$dir_path"
        done
    ' sh {} +
}
traverse_pages "$1"
