tool_name="hdconfigure_webapps_static_delete"

github_username="$1"
github_repo_name="$2"
webapp_parent_directory="$HOME/.config/hdconfigure/webapps/static/$github_username"
webapp_directory="$webapp_parent_directory/$github_repo_name"

# Check if both arguments are present
if [ -z "$github_username" ] || [ -z "$github_repo_name" ]; then
        error "error: $tool_name requires both <github_username> and <github_repo_name> arguments."
        exit 1
fi

# Check if the target directory exists before deletion
if [ ! -d "$webapp_directory" ]; then
        error "error: $tool_name failed to find directory. $webapp_directory is not a valid directory."
        exit 1
fi

# Recursively and forcefully remove the webapp directory, erroring and exiting 1 if it fails
if ! rm -rf "$webapp_directory"; then
        error "error: $tool_name failed to delete directory $webapp_directory."
        exit 1
fi
